{
  "name": "neurondeck",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_SESSIONS",
        "class_name": "ChatSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-chat-sessions",
      "new_sqlite_classes": ["ChatSession"]
    }
  ],
  "d1_databases": [
    {
      "binding": "METRICS_DB"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_SESSIONS"
    }
  ],
  "vars": {
    "CLOUDFLARE_OAUTH_SCOPES": "ai.read account-settings.read offline_access"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_AI_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "TTS_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
