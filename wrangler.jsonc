{
  "name": "neurondeck",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ai.chatgpt.org.uk",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "IMAGE_RESULTS",
      "bucket_name": "redacted-image-results"
    }
  ],
  "workflows": [
    {
      "binding": "IMAGE_WORKFLOW",
      "name": "neurondeck-image-generation",
      "class_name": "ImageGenerationWorkflow"
    }
  ],
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
